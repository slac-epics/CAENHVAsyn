# Boolean settings
file bo.template {
    pattern { R,              PARAM,                             DESC,                           ZNAM,   ONAM,  MASK }
            { "Pw",           "S$(SLOT)_C$(CHANNEL)_PW",         "Power on/off",                 "Off",  "On",  "1"  }
}

