file bi.template {
    pattern { R,              PARAM,                             DESC,                           ZNAM,   ONAM,  MASK,  SCAN    }
            { "Pw-RB",        "S$(SLOT)_C$(CHANNEL)_PW",         "Power on/off",                 "Off",  "On",  "1",   $(SCAN) }
}
